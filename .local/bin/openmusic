#!/bin/sh

MUSIC_DIR="$HOME/docs/music"

FILE_OPTIONS=$(find "$MUSIC_DIR" -maxdepth 1 -type f -exec basename {} \; | sed 's/\.[^.]*$//')
OPTIONS=$(printf "%s\nlofi-girl\nsynth-boy" "$FILE_OPTIONS")

OPTION=$(printf "%s\nrandom" "$OPTIONS" | dmenu-wl)
[ -z "$OPTION" ] && exit 0
pkill -x mpv

if [ "$OPTION" = "random" ]; then
    OPTION=$(printf "%s" "$OPTIONS" | shuf -n 1)
fi

if [ "$OPTION" = "lofi-girl" ]; then
    hyprctl dispatch "hl.dsp.exec_cmd(\"mpv https://youtu.be/jfKfPfyJRdk\", { workspace = \"7\" })"
    exit
elif [ "$OPTION" = "synth-boy" ]; then
    hyprctl dispatch "hl.dsp.exec_cmd(\"mpv https://youtu.be/4xDzrJKXOOY\", { workspace = \"7\" })"
    exit
fi

cd "$MUSIC_DIR" || exit 1
FILE=$(find . -type f -name "$OPTION*" | awk -F './' '{print $NF}')
hyprctl dispatch "hl.dsp.exec_cmd(\"mpv --loop=inf $MUSIC_DIR/$FILE\")"
