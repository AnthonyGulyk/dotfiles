#!/bin/sh
if ! pkill -INT -P "$(pgrep -xo record-screen)" wf-recorder 2>/dev/null; then
    geometry="$(slurp -d)"
    if [ -n "$geometry" ]; then
        pkill -USR1 -x record-screend
        mkdir -p ~/docs/videos/wf-recorder
        wf-recorder -f ~/docs/videos/wf-recorder/"screen-record-$(date +%Y-%m-%d-%H-%M-%S).mp4" -g "$geometry" -a --audio=alsa_output.pci-0000_00_1f.3.analog-stereo.monitor
        pkill -USR2 -x record-screend
    fi
fi
